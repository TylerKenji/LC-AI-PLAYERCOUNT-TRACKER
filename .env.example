# Steam Limbus AI Notifier - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Steam API Configuration
# Get your API key from: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# Notification Settings
NOTIFIER_EMAIL=your_email@example.com
CHECK_INTERVAL=60000
NOTIFICATION_THRESHOLD=1000

# Development Settings
TRACING=true
PORT=3000

# Azure Configuration (for deployment)
AZURE_WEBAPP_NAME=LCAIPlayerCountTracker
AZURE_RESOURCE_GROUP=rg-tylerNEW
AZURE_WEBAPP_URL=lcaiplayercounttracker-c9gge8gaecefasg8.westus-01.azurewebsites.net
